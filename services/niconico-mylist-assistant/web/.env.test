# E2E テスト環境変数
# Playwright テスト実行時に使用される環境変数

# インメモリDBを使用（テスト専用）
USE_IN_MEMORY_DB=true

# AWS 設定
# Note: インメモリモード時は DynamoDB に接続しないが、変数自体の定義は必要。
# core の getVideoRepository() は createVideoRepository(client, getTableName()) の形で
# 実装を切り替える前に getTableName() を評価するため、未定義だと
# 「環境変数 DYNAMODB_TABLE_NAME が設定されていません」で 500 になる。
# 実 dev/本番テーブル名は絶対に書かない（USE_IN_MEMORY_DB を外した際に dev DB を
# 汚染する事故を防ぐため、E2E 用のダミー名のみを置く）。
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=niconico-mylist-assistant-e2e-test

# 認証チェックをバイパス（テスト専用）
SKIP_AUTH_CHECK=true

# テストユーザー情報
TEST_USER_ID=test-user-id
TEST_USER_EMAIL=test@example.com
TEST_USER_NAME=Test User

# Next.js サーバーURL（ローカルテスト用）
BASE_URL=http://localhost:3000

# Auth サービス URL（テスト環境では使用しない）
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret（テスト環境用ダミー値）
NEXTAUTH_SECRET=test-secret-key-for-e2e-testing-only
