{
  "name": "@nagiyu/aws",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagiyu/nagiyu-platform.git",
    "directory": "libs/aws"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node ../write-cjs-marker.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-batch": "^3.1063.0",
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-lambda": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-secrets-manager": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@nagiyu/common": "^0.1.1"
  }
}
