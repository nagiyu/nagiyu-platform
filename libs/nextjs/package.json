{
  "name": "@nagiyu/nextjs",
  "version": "0.2.0-next.0",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./middleware": {
      "types": "./dist/src/middleware.d.ts",
      "import": "./dist/src/middleware.js",
      "require": "./dist/cjs/middleware.js"
    },
    "./session": {
      "types": "./dist/src/session.d.ts",
      "import": "./dist/src/session.js",
      "require": "./dist/cjs/session.js"
    },
    "./types/next-auth": {
      "types": "./src/types/next-auth.d.ts"
    }
  },
  "files": [
    "dist/src",
    "dist/cjs",
    "src/types/next-auth.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagiyu/nagiyu-platform.git",
    "directory": "libs/nextjs"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node ../write-cjs-marker.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nagiyu/common": "^0.2.0-next.0",
    "next-auth": "^5.0.0-beta.32"
  },
  "peerDependencies": {
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "next": ">=16.1.7"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/lib-dynamodb": "^3.1063.0"
  }
}
