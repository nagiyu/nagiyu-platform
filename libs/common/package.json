{
  "name": "@nagiyu/common",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./push": {
      "types": "./dist/src/push/index.d.ts",
      "import": "./dist/src/push/index.js",
      "require": "./dist/cjs/push/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagiyu/nagiyu-platform.git",
    "directory": "libs/common"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node ../write-cjs-marker.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "web-push": "^4.0.0"
  }
}
