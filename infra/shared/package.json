{
  "name": "@nagiyu/infra-shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Infrastructure (VPC, IAM, ACM) for Nagiyu Platform",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'bin/**/*.ts' 'lib/**/*.ts' 'libs/**/*.ts'",
    "watch": "tsc -w",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk": "cdk",
    "bootstrap": "cdk bootstrap",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0"
  }
}
